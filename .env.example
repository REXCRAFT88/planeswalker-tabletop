# Server configuration for Planeswalker Tabletop

# --- AI opponents ---
# AI opponents work with any of three providers. Set the API key(s) for the
# provider(s) you want available. AI is enabled if at least one key is present;
# without any, AI seats fall back to hot-seat play and /api/ai/* returns 503.
ANTHROPIC_API_KEY=      # Claude   (default model claude-opus-4-8)
OPENAI_API_KEY=         # ChatGPT  (default model gpt-4o)
GEMINI_API_KEY=         # Gemini   (default model gemini-2.0-flash)

# Optional: default provider when more than one key is set (anthropic | openai | gemini).
# Falls back to the first configured provider. Per-opponent selection in the UI
# overrides this.
# AI_PROVIDER=anthropic

# Optional per-provider model overrides:
# ANTHROPIC_MODEL=claude-opus-4-8
# OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-2.0-flash

# Optional: max tool rounds per AI turn before it force-ends (default 12)
# AI_MAX_ROUNDS=12

# --- Voice negotiation ---
# The free default voice backend is the browser's Web Speech API (no config).
# Setting OPENAI_API_KEY (above) also enables the OpenAI Realtime voice backend,
# selectable per-conversation in the Negotiate panel. Optional overrides:
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=alloy
# OPENAI_REALTIME_URL=https://api.openai.com/v1/realtime/calls

# Port for the Socket.IO / API server (defaults to 3001)
# PORT=3001
